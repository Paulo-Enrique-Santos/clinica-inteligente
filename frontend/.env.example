# Copie para .env.local (ignorado pelo git):
#   cp frontend/.env.example frontend/.env.local
#
# Nenhuma destas variaveis tem prefixo NEXT_PUBLIC_, e isso e proposital: todas ficam
# apenas no servidor do Next. O client secret e o access token nunca chegam ao navegador.

# Assina o cookie de sessao. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=troque-por-um-valor-aleatorio
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Client confidencial do Keycloak (ver infra/keycloak/import/clinica-realm.json)
AUTH_KEYCLOAK_ID=clinica-web
AUTH_KEYCLOAK_SECRET=dev-secret-clinica-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/clinica

# API .NET
API_BASE_URL=http://localhost:5231
APP_BASE_URL=http://localhost:3000
