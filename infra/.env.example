# Copie para .env (que e ignorado pelo git) e ajuste se quiser:
#   cp .env.example .env
#
# ATENCAO: estes valores sao de DESENVOLVIMENTO LOCAL. Em producao (Fase 14) as
# credenciais vem de secret manager / variaveis do host, nunca de arquivo no repo.

# ---------- Postgres (superusuario, usado so pelo container e pelas migrations) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_PORT=5432

# ---------- Banco da aplicacao ----------
APP_DB_NAME=clinica
# Dono das tabelas: roda as migrations do EF Core.
APP_DB_OWNER=clinica_owner
APP_DB_OWNER_PASSWORD=owner_dev_only
# Usuario de runtime da API: sem privilegio de dono, para o RLS valer de verdade.
APP_DB_USER=clinica_app
APP_DB_USER_PASSWORD=app_dev_only

# ---------- Banco do Keycloak ----------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_only

# ---------- Keycloak ----------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_PORT=8080
