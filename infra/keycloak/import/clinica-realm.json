      "lastName": "Duarte",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        { "type": "password", "value": "dev123", "temporary": false }
      ],
      "realmRoles": ["FINANCE"]
    },
    {
      "username": "rita.owner",
      "email": "rita.owner@nova.test",
