{
  "realm": "clinica",
  "displayName": "Clinica Inteligente",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "OWNER",
        "description": "Dona da clinica: acesso total ao tenant, incluindo financeiro e configuracao."
      },
      {
        "name": "DOCTOR",
        "description": "Doutora: agenda propria, prontuario, anamnese e fila HITL clinica."
      },
      {
        "name": "SECRETARY",
        "description": "Secretaria: agenda geral, pacientes, conversas e fila HITL de atendimento."
      },
      {
        "name": "FINANCE",
        "description": "Financeiro: pagamentos, cobrancas, estoque e fila HITL financeira."
      },
      {
        "name": "AGENT",
        "description": "Identidade de maquina dos agentes de IA. Permissoes DELIBERADAMENTE menores que as de humano: nunca concede desconto, nunca exclui dado, nunca acessa configuracao."
      }
    ]
  },

  "clients": [
    {
      "clientId": "clinica-web",
      "name": "Painel Web (Next.js)",
      "description": "Cliente confidencial. O Next roda server-side, entao guarda o secret com seguranca.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-secret-clinica-web",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-clinica-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "clinica-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clinica-api",
      "name": "API .NET (resource server)",
      "description": "Nao inicia fluxo nenhum. Existe para ser a audience dos tokens que a API valida.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-secret-clinica-api",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "clinica-agents",
      "name": "Servico de Agentes (Python)",
      "description": "Client credentials para o servico de agentes. O token dele NAO carrega tenant_id: acesso a dado de tenant usa token com escopo de execucao emitido pela API (ver docs/adr/0002).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-secret-clinica-agents",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-clinica-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "clinica-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
